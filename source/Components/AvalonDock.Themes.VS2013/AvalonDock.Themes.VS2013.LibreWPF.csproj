<Project Sdk="LibreWPF.Sdk">
	<!-- The LibreWPF twin of AvalonDock.Themes.VS2013.csproj (see source/Directory.Build.props). -->
	<PropertyGroup>
		<AssemblyName>AvalonDock.Themes.VS2013</AssemblyName>
		<RootNamespace>AvalonDock.Themes</RootNamespace>
		<PackageId>Dirkster.AvalonDock.Themes.VS2013.LibreWPF</PackageId>
		<AssemblyOriginatorKeyFile>sn.snk</AssemblyOriginatorKeyFile>
		<SignAssembly>true</SignAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="**\*.png"/>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources\vs2013blue.vstheme.gz"/>
		<EmbeddedResource Include="Resources\vs2013dark.vstheme.gz"/>
		<EmbeddedResource Include="Resources\vs2013light.vstheme.gz"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AvalonDock\AvalonDock.LibreWPF.csproj"/>
		<ProjectReference Include="..\AvalonDock.Themes.VS\AvalonDock.Themes.VS.LibreWPF.csproj"/>
	</ItemGroup>
</Project>
