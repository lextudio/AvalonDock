<Project>
	<PropertyGroup>
		<!-- This fork can be checked out below OpenDevelop, which uses central package management. -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<!-- Centralized Target Frameworks -->
		<ComponentTargetFrameworks>net9.0-windows;net10.0-windows;net48</ComponentTargetFrameworks>
		<TestTargetFrameworks>net9.0-windows;net10.0-windows;net48</TestTargetFrameworks>
		<LangVersion>13</LangVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- Version Information -->
		<VersionPrefix>5.0.1</VersionPrefix>
		<AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
		<FileVersion>$(VersionPrefix).0</FileVersion>
		<Company>Open Source</Company>
		<Product>Dirkster.AvalonDock</Product>
		<Copyright>2017-2026</Copyright>
		<Description>This assembly implements a docking layout system for WPF.</Description>
		<PackageProjectUrl>https://github.com/Dirkster99/AvalonDock</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lextudio/AvalonDock</RepositoryUrl>
		<Authors>https://github.com/Dirkster99/AvalonDock</Authors>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>WPF avalondock docking layout MVVM</PackageTags>

		<!-- Single source of truth for the license shipped in every NuGet package -->
		<PackageLicenseSourceFile>$(MSBuildThisFileDirectory)..\LICENSE</PackageLicenseSourceFile>
		<PackageReadmeSourceFile>$(MSBuildThisFileDirectory)..\README.md</PackageReadmeSourceFile>

		<!-- Enforce zero warnings policy -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
	<!--
		The LibreWPF line: projects named *.LibreWPF.csproj (and the temporary *.LibreWPF_*_wpftmp.csproj the markup compiler derives) sit next to their WPF twin, build with
		LibreWPF.Sdk on every OS and define LIBREWPF; the WPF projects never import that SDK. They are
		not linked from another folder because the WPF markup compiler flattens the BAML of XAML pages
		that live outside the project folder (two Generic.xaml files overwrite each other), so each one
		compiles the sources of its own folder and keeps its obj/bin apart from the WPF project's.
		See docs/librewpf.md, section 11.
	-->
	<PropertyGroup Condition="$(MSBuildProjectName.Contains('.LibreWPF'))">
		<BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\librewpf\</BaseIntermediateOutputPath>
		<MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
		<BaseOutputPath>$(MSBuildProjectDirectory)\bin\librewpf\</BaseOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<!-- Defined by the project, not by $(OS): ProGPU-only code sits behind it in the shared sources. -->
		<DefineConstants>$(DefineConstants);LIBREWPF</DefineConstants>
		<!-- LibreWPF.Sdk defaults its net10 support packages (incl. Cryptography.Xml/Pkcs) to 10.0.11, flagged NU1902/NU1903; 10.0.13 is patched. -->
		<ProGpuWpfNet10SupportPackageVersion>10.0.13</ProGpuWpfNet10SupportPackageVersion>
		<NoWarn>$(NoWarn);NU5104</NoWarn>
		<!-- The fork's dev-time quality gates belong to the WPF line; the LibreWPF packages are
		     OpenDevelop dependencies and must build cleanly on the ProGPU platform. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<RunAnalyzers>false</RunAnalyzers>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<!-- Pack the shared root LICENSE into every package without copying it per project -->
		<None Include="$(PackageLicenseSourceFile)" Pack="true" PackagePath="" Visible="false" />
		<None Include="$(PackageReadmeSourceFile)" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers"
			Version="10.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers;
				buildtransitive
			</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt"
			Condition="Exists('$(MSBuildThisFileDirectory)CodeMetricsConfig.txt')" />
		<PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<Choose>
		<When
			Condition="'$(MSBuildProjectName.Contains(`Test`))' == 'false'">
			<ItemGroup>
				<!--        Enable to active stylecop for the whole solution-->
				<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
					<PrivateAssets>all</PrivateAssets>
					<IncludeAssets>runtime; build; native; contentfiles; analyzers;
						buildtransitive
					</IncludeAssets>
				</PackageReference>
			</ItemGroup>
		</When>
	</Choose>
</Project>
