<Project>
	<PropertyGroup>
		<!-- This fork can be checked out below OpenDevelop, which uses central package management. -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<!-- LibreWPF.Sdk defaults its net10 support packages (incl. Cryptography.Xml/Pkcs) to 10.0.11, flagged NU1902/NU1903; 10.0.13 is patched. -->
		<ProGpuWpfNet10SupportPackageVersion>10.0.13</ProGpuWpfNet10SupportPackageVersion>
		<!-- Centralized Target Frameworks -->
		<ComponentTargetFrameworks>net10.0-windows</ComponentTargetFrameworks>
		<TestTargetFrameworks>net10.0-windows</TestTargetFrameworks>
		<LangVersion>13</LangVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- Set wherever LibreWPF.Sdk is the SDK in use (see the conditional Sdk imports in the
		     component projects). Code that touches ProGPU-only API must sit behind this, because those
		     types do not exist in the upstream WPF build. -->
		<DefineConstants Condition="'$(OS)' != 'Windows_NT'">$(DefineConstants);LIBREWPF</DefineConstants>

		<!-- Version Information -->
		<VersionPrefix>5.0.1</VersionPrefix>
		<AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
		<FileVersion>$(VersionPrefix).0</FileVersion>
		<Company>Open Source</Company>
		<Product>Dirkster.AvalonDock</Product>
		<Copyright>2017-2026</Copyright>
		<Description>This assembly implements a docking layout system for WPF.</Description>
		<PackageProjectUrl>https://github.com/Dirkster99/AvalonDock</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lextudio/AvalonDock</RepositoryUrl>
		<Authors>https://github.com/Dirkster99/AvalonDock</Authors>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>WPF avalondock docking layout MVVM</PackageTags>

		<!-- Single source of truth for the license shipped in every NuGet package -->
		<PackageLicenseSourceFile>$(MSBuildThisFileDirectory)..\LICENSE</PackageLicenseSourceFile>
		<PackageReadmeSourceFile>$(MSBuildThisFileDirectory)..\README.md</PackageReadmeSourceFile>

		<!-- Enforce zero warnings policy -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
	<!--
		LibreWPF: WPF components use Sdk="LibreWPF.Sdk" so builds on non-Windows hosts run on the
		portable ProGPU/Silk.NET platform. On Windows hosts the LibreWPF SDK must behave exactly
		like Microsoft.NET.Sdk.WindowsDesktop, so its portable mode is switched off.
		(This file is imported after the LibreWPF Sdk.props defaults, so plain assignments win.)
	-->
	<PropertyGroup Condition="'$(_ProGpuWpfSdkImported)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
		<ProGpuWpfUsePortableFrameworkReferences>false</ProGpuWpfUsePortableFrameworkReferences>
		<ProGpuWpfUsePortablePlatform>false</ProGpuWpfUsePortablePlatform>
		<ProGpuWpfEnablePortableBootstrap>false</ProGpuWpfEnablePortableBootstrap>
		<ProGpuWpfEnableWin32CompatShim>false</ProGpuWpfEnableWin32CompatShim>
		<ProGpuWpfUseCurrentRuntimeIdentifier>false</ProGpuWpfUseCurrentRuntimeIdentifier>
		<RuntimeIdentifier></RuntimeIdentifier>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<!-- Pack the shared root LICENSE into every package without copying it per project -->
		<None Include="$(PackageLicenseSourceFile)" Pack="true" PackagePath="" Visible="false" />
		<None Include="$(PackageReadmeSourceFile)" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers"
			Version="10.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers;
				buildtransitive
			</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt"
			Condition="Exists('$(MSBuildThisFileDirectory)CodeMetricsConfig.txt')" />
		<PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<Choose>
		<When
			Condition="'$(MSBuildProjectName.Contains(`Test`))' == 'false'">
			<ItemGroup>
				<!--        Enable to active stylecop for the whole solution-->
				<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
					<PrivateAssets>all</PrivateAssets>
					<IncludeAssets>runtime; build; native; contentfiles; analyzers;
						buildtransitive
					</IncludeAssets>
				</PackageReference>
			</ItemGroup>
		</When>
	</Choose>
</Project>
