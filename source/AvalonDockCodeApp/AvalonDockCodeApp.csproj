<Project>
	<!-- Same pattern as AvalonDock.csproj: the Sdk attribute cannot carry a Condition. Off Windows
	     LibreWPF.Sdk (ProGPU) builds the project; on Windows the stock WindowsDesktop SDK does, as upstream.
	     Importing LibreWPF.Sdk on Windows as well adds every XAML file as a Page twice (NETSDK1022).
	     Keep the matching Sdk.targets import at the end of the file. -->
	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.WindowsDesktop" Condition="'$(OS)' == 'Windows_NT'" />
	<Import Project="Sdk.props" Sdk="LibreWPF.Sdk" Condition="'$(OS)' != 'Windows_NT'" />
    <PropertyGroup>
        <RootNamespace>ToggleTestApp</RootNamespace>
        <TargetFrameworks>$(ComponentTargetFrameworks)</TargetFrameworks>
        <UseWPF>true</UseWPF>
        <ApplicationIcon />
        <OutputType>WinExe</OutputType>
        <StartupObject />
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <PackageId>AvalonDockCodeApp</PackageId>
        <!-- Sample app: no XML documentation file, so StyleCop's XML comment analysis stays off -->
        <NoWarn>$(NoWarn);SA0001</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Components\AvalonDock\AvalonDock.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Core\AvalonDock.Core.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Mvvm\AvalonDock.Mvvm.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Mvvm.CommunityToolkit\AvalonDock.Mvvm.CommunityToolkit.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.DependencyInjection\AvalonDock.DependencyInjection.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Serializer.Xml\AvalonDock.Serializer.Xml.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Themes.Arc\AvalonDock.Themes.Arc.csproj" />
        <ProjectReference Include="..\Components\AvalonDock.Themes.VS\AvalonDock.Themes.VS.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    </ItemGroup>
	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.WindowsDesktop" Condition="'$(OS)' == 'Windows_NT'" />
	<Import Project="Sdk.targets" Sdk="LibreWPF.Sdk" Condition="'$(OS)' != 'Windows_NT'" />
</Project>
